# LCI Platform Environment Configuration
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql://lci:change-me@db:5432/lci_platform

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here

# Paystack (required for admissions & billing)
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxx

# Email (Resend or SMTP)
RESEND_API_KEY=re_xxx
# Or SMTP fallback:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user
# SMTP_PASS=pass
# SMTP_FROM="Institute <noreply@institute.edu>"

# Storage (Tigris or R2)
TIGRIS_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_BUCKET={{SLUG}}-storage
TIGRIS_ACCESS_KEY_ID=xxx
TIGRIS_SECRET_ACCESS_KEY=xxx

# Control Plane (for license check-in)
CONTROL_PLANE_URL=https://dashboard.abdac-consult.com
TENANT_API_KEY=xxx
CHECK_IN_INTERVAL_MINUTES=15

# Entitlement Record (generated by dashboard)
ENTITLEMENT_RECORD_PATH=/app/entitlement-record.json
ENTITLEMENT_PUBLIC_KEY_PATH=/app/entitlement-public-key.pem

# Voucher Price (required for admissions)
VOUCHER_PRICE=100

# Branding
INSTITUTION_NAME={{NAME}}
INSTITUTION_SLUG={{SLUG}}
DEFAULT_CURRENCY={{CURRENCY}}
TIMEZONE={{TIMEZONE}}