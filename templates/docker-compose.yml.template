# LCI Platform - {{NAME}} Deployment
# Generated by create-institute-app

services:
  db:
    image: postgres:16
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-lci}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-change-me}
      POSTGRES_DB: ${POSTGRES_DB:-lci_platform}
    ports:
      - '${POSTGRES_PORT:-5432}:5432'
    volumes:
      - db-data:/var/lib/postgresql/data
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U $${POSTGRES_USER:-lci}']
      interval: 5s
      timeout: 5s
      retries: 5

  api:
    image: lci-platform-api:latest
    env_file: .env
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped

  web:
    image: lci-platform-web:latest
    restart: unless-stopped

  worker:
    image: lci-platform-worker:latest
    env_file: .env
    depends_on:
      db:
        condition: service_healthy
    restart: unless-stopped

  reverse-proxy:
    image: lci-platform-proxy:latest
    ports:
      - '80:80'
      - '443:443'
    volumes:
      - ./certs:/etc/nginx/certs:ro
    restart: unless-stopped

volumes:
  db-data: